# Derived from vendor/part0_pins.xml; all user I/O is 1.8 V.
set_property PACKAGE_PIN AA28 [get_ports {sys_clk}]
set_property IOSTANDARD LVCMOS18 [get_ports {sys_clk}]
set_property PACKAGE_PIN J8 [get_ports {pcie_refclk_clk_p}]
set_property PACKAGE_PIN J7 [get_ports {pcie_refclk_clk_n}]
set_property PACKAGE_PIN Y26 [get_ports {pcie_perstn}]
set_property IOSTANDARD LVCMOS18 [get_ports {pcie_perstn}]
set_property PACKAGE_PIN N24 [get_ports {iic_lm73_scl_io}]
set_property IOSTANDARD LVCMOS18 [get_ports {iic_lm73_scl_io}]
set_property PACKAGE_PIN N25 [get_ports {iic_lm73_sda_io}]
set_property IOSTANDARD LVCMOS18 [get_ports {iic_lm73_sda_io}]
set_property PACKAGE_PIN P30 [get_ports {led_3bits_tri_o[0]}]
set_property IOSTANDARD LVCMOS18 [get_ports {led_3bits_tri_o[0]}]
set_property PACKAGE_PIN M30 [get_ports {led_3bits_tri_o[1]}]
set_property IOSTANDARD LVCMOS18 [get_ports {led_3bits_tri_o[1]}]
set_property PACKAGE_PIN N30 [get_ports {led_3bits_tri_o[2]}]
set_property IOSTANDARD LVCMOS18 [get_ports {led_3bits_tri_o[2]}]
set_property PACKAGE_PIN F2 [get_ports {pci_express_x8_txp[0]}]
set_property PACKAGE_PIN F1 [get_ports {pci_express_x8_txn[0]}]
set_property PACKAGE_PIN H6 [get_ports {pci_express_x8_rxp[0]}]
set_property PACKAGE_PIN H5 [get_ports {pci_express_x8_rxn[0]}]
set_property PACKAGE_PIN H2 [get_ports {pci_express_x8_txp[1]}]
set_property PACKAGE_PIN H1 [get_ports {pci_express_x8_txn[1]}]
set_property PACKAGE_PIN J4 [get_ports {pci_express_x8_rxp[1]}]
set_property PACKAGE_PIN J3 [get_ports {pci_express_x8_rxn[1]}]
set_property PACKAGE_PIN K2 [get_ports {pci_express_x8_txp[2]}]
set_property PACKAGE_PIN K1 [get_ports {pci_express_x8_txn[2]}]
set_property PACKAGE_PIN K6 [get_ports {pci_express_x8_rxp[2]}]
set_property PACKAGE_PIN K5 [get_ports {pci_express_x8_rxn[2]}]
set_property PACKAGE_PIN M2 [get_ports {pci_express_x8_txp[3]}]
set_property PACKAGE_PIN M1 [get_ports {pci_express_x8_txn[3]}]
set_property PACKAGE_PIN L4 [get_ports {pci_express_x8_rxp[3]}]
set_property PACKAGE_PIN L3 [get_ports {pci_express_x8_rxn[3]}]
set_property PACKAGE_PIN N4 [get_ports {pci_express_x8_txp[4]}]
set_property PACKAGE_PIN N3 [get_ports {pci_express_x8_txn[4]}]
set_property PACKAGE_PIN M6 [get_ports {pci_express_x8_rxp[4]}]
set_property PACKAGE_PIN M5 [get_ports {pci_express_x8_rxn[4]}]
set_property PACKAGE_PIN P2 [get_ports {pci_express_x8_txp[5]}]
set_property PACKAGE_PIN P1 [get_ports {pci_express_x8_txn[5]}]
set_property PACKAGE_PIN P6 [get_ports {pci_express_x8_rxp[5]}]
set_property PACKAGE_PIN P5 [get_ports {pci_express_x8_rxn[5]}]
set_property PACKAGE_PIN T2 [get_ports {pci_express_x8_txp[6]}]
set_property PACKAGE_PIN T1 [get_ports {pci_express_x8_txn[6]}]
set_property PACKAGE_PIN R4 [get_ports {pci_express_x8_rxp[6]}]
set_property PACKAGE_PIN R3 [get_ports {pci_express_x8_rxn[6]}]
set_property PACKAGE_PIN U4 [get_ports {pci_express_x8_txp[7]}]
set_property PACKAGE_PIN U3 [get_ports {pci_express_x8_txn[7]}]
set_property PACKAGE_PIN T6 [get_ports {pci_express_x8_rxp[7]}]
set_property PACKAGE_PIN T5 [get_ports {pci_express_x8_rxn[7]}]
create_clock -name sys_clk -period 20.000 [get_ports sys_clk]
create_clock -name pcie_refclk -period 10.000 [get_ports pcie_refclk_clk_p]
set_property CFGBVS GND [current_design]
set_property CONFIG_VOLTAGE 1.8 [current_design]
set_property BITSTREAM.CONFIG.UNUSEDPIN Pullnone [current_design]
set_false_path -from [get_ports pcie_perstn]
# LEDs and I2C have no synchronous external timing contract.
set_false_path -to [get_ports {led_3bits_tri_o[*] iic_lm73_scl_io iic_lm73_sda_io}]
set_false_path -from [get_ports {iic_lm73_scl_io iic_lm73_sda_io}]

# Only the first stage of the explicit PCIe-state synchronizer is asynchronous.
set_false_path -to [get_pins -hier -filter {NAME =~ */status/inst/sync1_reg*/D}]
